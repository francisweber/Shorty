{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorty.dev/schemas/component-metadata.schema.json",
  "title": "Shorty component metadata",
  "description": "Validates component metadata documents.",
  "type": "object",
  "required": [
    "metadataVersion",
    "name",
    "description",
    "category",
    "dataSchema"
  ],
  "properties": {
    "metadataVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "dataSchema": {
      "type": "object",
      "required": [
        "$schema"
      ],
      "properties": {
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "additionalProperties": true,
      "description": "A JSON Schema document using Draft 2020-12."
    }
  },
  "additionalProperties": false
}
